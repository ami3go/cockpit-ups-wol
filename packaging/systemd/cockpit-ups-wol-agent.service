[Unit]
Description=cockpit-ups-wol power management agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStart=/usr/libexec/cockpit-ups-wol/cockpit-ups-wol-agent --foreground
Restart=always
RestartSec=10s
WatchdogSec=30s
NotifyAccess=main
RuntimeDirectory=cockpit-ups-wol
StateDirectory=cockpit-ups-wol
ConfigurationDirectory=cockpit-ups-wol
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BROADCAST CAP_NET_ADMIN CAP_KILL CAP_SYS_BOOT
ReadWritePaths=/var/lib/cockpit-ups-wol /run/cockpit-ups-wol /etc/cockpit-ups-wol

[Install]
WantedBy=multi-user.target
